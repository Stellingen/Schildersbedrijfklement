{
    admin off
    auto_https off
    persist_config off
}

:{$PORT:3000} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Cache-Control "public, max-age=0, must-revalidate"
    }

    handle /health {
        respond "ok" 200
    }

    handle {
        root * /srv
        file_server
    }
}
