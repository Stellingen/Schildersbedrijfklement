# Set these in the WEBSITE service on Railway, not in the repository.
MYSQL_URL=
BRAND_ADMIN_USERNAME=Beheer
BRAND_ADMIN_PASSWORD=
APP_URL=https://lijnenlaag.example
# Optional: notifications. Form submissions are saved without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=info@lijnenlaag.example

# Separate database for this independent brand. No legacy enquiries or accounts are copied.
BRAND_DATABASE=lijnenlaag
DEMO_MODE=true
